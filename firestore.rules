rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // -------------------------------------------------------------------------
    // 0. Global Catch-All (Default Deny)
    // -------------------------------------------------------------------------
    match /{document=**} {
      allow read, write: if false;
    }

    // -------------------------------------------------------------------------
    // Helper Functions
    // -------------------------------------------------------------------------
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // -------------------------------------------------------------------------
    // Collection: Users
    // -------------------------------------------------------------------------
    match /users/{userId} {
      // Public User Profile
      allow read: if isSignedIn();
      
      // Validation for Public Profile
      function isValidPublicUser(data) {
        return data.keys().hasAll(['uid', 'name']) &&
               data.uid == userId &&
               data.uid == request.auth.uid &&
               data.name is string && data.name.size() > 0 && data.name.size() < 100 &&
               (!('mobile' in data)) && // PII MUST go to private subcollection
               (!('walletBalance' in data)) &&
               (!('superChatBalance' in data)) &&
               (!('bankAccountNumber' in data));
      }

      allow create: if isOwner(userId) && isValidPublicUser(incoming());
      
      allow update: if isOwner(userId) && 
                      incoming().uid == userId &&
                      incoming().diff(existing()).affectedKeys().hasOnly(['name', 'bio', 'profileImage', 'website', 'isPrivate', 'updatedAt', 'socialLinks', 'location', 'gender', 'dob', 'interests', 'followersCount', 'followingCount', 'totalViews', 'totalLikes', 'monetizationStatus', 'monetizationDate', 'policyViolations', 'lastActive', 'country', 'role']) && 
                      (!('mobile' in incoming())) &&
                      (!('walletBalance' in incoming())) &&
                      (!('bankAccountNumber' in incoming()));

      // Private User Data (PII & Financial)
      match /private/data {
        allow read: if isOwner(userId) || isAdmin();
        
        function isValidPrivateUser(data) {
          return data.keys().hasAll(['walletBalance', 'superChatBalance']) &&
                 data.walletBalance is number &&
                 data.superChatBalance is number &&
                 (data.mobile == null || (data.mobile is string && data.mobile.size() >= 10));
        }

        allow create, update: if (isOwner(userId) || isAdmin()) && isValidPrivateUser(incoming());
      }
    }

    // -------------------------------------------------------------------------
    // Collection: Videos
    // -------------------------------------------------------------------------
    match /videos/{videoId} {
      allow read: if isSignedIn();
      
      function isValidVideo(data) {
        return data.keys().hasAll(['userId', 'videoUrl']) &&
               isValidId(data.userId) &&
               data.videoUrl is string && data.videoUrl.size() > 0;
      }

      allow create: if isSignedIn() && isValidVideo(incoming()) && incoming().userId == request.auth.uid;
      allow update: if (isSignedIn() && existing().userId == request.auth.uid) || isAdmin();
      allow delete: if (isSignedIn() && existing().userId == request.auth.uid) || isAdmin();
    }

    // -------------------------------------------------------------------------
    // Collection: Comments
    // -------------------------------------------------------------------------
    match /comments/{commentId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && incoming().userId == request.auth.uid;
      allow update, delete: if (isSignedIn() && existing().userId == request.auth.uid) || isAdmin();
    }

    // -------------------------------------------------------------------------
    // Collection: Follows
    // -------------------------------------------------------------------------
    match /follows/{followId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && incoming().followerId == request.auth.uid;
      allow delete: if (isSignedIn() && (existing().followerId == request.auth.uid || existing().followingId == request.auth.uid)) || isAdmin();
    }

    // -------------------------------------------------------------------------
    // Collection: Notifications
    // -------------------------------------------------------------------------
    match /notifications/{notifId} {
      allow read: if isOwner(existing().userId);
      allow create: if isSignedIn(); // Users notify each other
      allow update: if isOwner(existing().userId) && incoming().diff(existing()).affectedKeys().hasOnly(['read']);
    }

    // -------------------------------------------------------------------------
    // Collection: Super Chats
    // -------------------------------------------------------------------------
    match /super_chats/{chatId} {
      allow read: if isSignedIn() && (resource.data.senderId == request.auth.uid || resource.data.receiverId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && incoming().senderId == request.auth.uid;
    }

    // -------------------------------------------------------------------------
    // Collection: Withdrawal Requests
    // -------------------------------------------------------------------------
    match /withdrawal_requests/{requestId} {
      allow read: if isOwner(resource.data.userId) || isAdmin();
      allow create: if isOwner(incoming().userId);
      allow update: if isAdmin();
    }

    // -------------------------------------------------------------------------
    // Collection: Transactions
    // -------------------------------------------------------------------------
    match /transactions/{txId} {
      allow read: if isOwner(resource.data.userId) || isAdmin();
      allow create: if isOwner(incoming().userId) || isAdmin();
    }

    // -------------------------------------------------------------------------
    // Collection: Boost Transactions
    // -------------------------------------------------------------------------
    match /boost_transactions/{txId} {
      allow read: if isOwner(resource.data.userId) || isAdmin();
      allow create: if isOwner(incoming().userId) || isAdmin();
    }

    // -------------------------------------------------------------------------
    // Collection: Admin Tasks
    // -------------------------------------------------------------------------
    match /admin_tasks/{taskId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.assignedToId == request.auth.uid);
      allow create: if isAdmin();
      allow update: if isAdmin() || (isSignedIn() && resource.data.assignedToId == request.auth.uid && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt']));
    }

    // -------------------------------------------------------------------------
    // Collection: Chat Rooms (if exists)
    // -------------------------------------------------------------------------
    match /chat_rooms/{roomId} {
      allow read, write: if isSignedIn() && (request.auth.uid in resource.data.participantIds || request.auth.uid in incoming().participantIds);
      
      match /messages/{msgId} {
        allow read: if isSignedIn() && (get(/databases/$(database)/documents/chat_rooms/$(roomId)).data.participantIds.hasAny([request.auth.uid]));
        allow create: if isSignedIn() && incoming().senderId == request.auth.uid;
      }
    }
    
    // -------------------------------------------------------------------------
    // Collection: Admins (Control List)
    // -------------------------------------------------------------------------
    match /admins/{adminId} {
      allow read: if isSignedIn();
      allow write: if false; // Only manageable via console
    }
  }
}
