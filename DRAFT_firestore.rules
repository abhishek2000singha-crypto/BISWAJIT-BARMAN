rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // ===============================================================
    // Helper Functions
    // ===============================================================
    
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && (
        // Check for specific admin email with verification
        (request.auth.token.email == "abhishek2000singha@gmail.com" && request.auth.token.email_verified == true) ||
        // Check if user has admin role in database
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
      );
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // ===============================================================
    // Entity Validators
    // ===============================================================

    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'name', 'mobile']) &&
             data.uid == request.auth.uid &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 50 &&
             data.mobile is string && data.mobile.size() >= 10 && data.mobile.size() <= 15 &&
             (!('bio' in data) || (data.bio is string && data.bio.size() <= 200)) &&
             (!('profileImage' in data) || (data.profileImage is string && data.profileImage.size() <= 1000)) &&
             (!('role' in data) || data.role in ['user', 'admin', 'banned']);
    }

    function isValidVideo(data) {
      return data.keys().hasAll(['userId', 'videoUrl', 'thumbnailUrl', 'type']) &&
             data.userId == request.auth.uid &&
             data.videoUrl is string && data.videoUrl.size() <= 1000 &&
             data.thumbnailUrl is string && data.thumbnailUrl.size() <= 1000 &&
             data.type in ['video', 'photo'] &&
             (!('caption' in data) || (data.caption is string && data.caption.size() <= 1000));
    }

    function isValidComment(data) {
      return data.keys().hasAll(['videoId', 'userId', 'text', 'createdAt']) &&
             data.userId == request.auth.uid &&
             data.text is string && data.text.size() > 0 && data.text.size() <= 500 &&
             isValidId(data.videoId);
    }

    function isValidFollow(data) {
      return data.keys().hasAll(['followerId', 'followingId', 'createdAt']) &&
             data.followerId == request.auth.uid &&
             data.followerId != data.followingId &&
             isValidId(data.followingId);
    }

    // ===============================================================
    // Match Blocks
    // ===============================================================

    // User Profiles (Public)
    match /users/{userId} {
      allow read: if true;
      allow create: if isOwner(userId) && isValidId(userId) && isValidUser(incoming()) && 
                    incoming().role == 'user' &&
                    !('walletBalance' in incoming()) && !('mobile' in incoming()); // Enforce split
      
      allow update: if isOwner(userId) && isValidId(userId) && (
        (incoming().diff(existing()).affectedKeys().hasOnly(['name', 'bio', 'profileImage', 'isProfileSetupComplete', 'referralCode', 'referredBy']) && 
         isValidUser(incoming())) ||
        (incoming().diff(existing()).affectedKeys().hasOnly(['followersCount', 'followingCount', 'totalLikes', 'totalViews', 'videosCount', 'totalWatchTime']))
      ) || isAdmin();
    }

    // User Private Data
    match /users/{userId}/private/data {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId) && 
                    incoming().keys().hasAll(['mobile', 'walletBalance', 'superChatBalance']);
      allow update: if isAdmin() || (
        isOwner(userId) && 
        incoming().diff(existing()).affectedKeys().hasOnly(['mobile']) // User can only change mobile? Maybe not even that.
      );
    }

    // Videos
    match /videos/{videoId} {
      allow read: if true;
      allow create: if isSignedIn() && isValidId(videoId) && isValidVideo(incoming()) &&
                    exists(/databases/$(database)/documents/users/$(request.auth.uid));
      
      allow update: if (
        (isOwner(existing().userId) && isValidVideo(incoming()) && 
         incoming().diff(existing()).affectedKeys().hasOnly(['caption', 'musicName', 'filter'])) ||
        // Engagement update
        (incoming().diff(existing()).affectedKeys().hasOnly(['likesCount', 'viewsCount', 'sharesCount', 'commentsCount']))
      ) || isAdmin();
      
      allow delete: if isOwner(existing().userId) || isAdmin();
    }

    // Likes (relational sub-resource)
    match /likes/{likeId} {
      allow read: if true;
      allow create: if isSignedIn() && isValidId(likeId) && 
                    incoming().userId == request.auth.uid &&
                    exists(/databases/$(database)/documents/videos/$(incoming().videoId));
      allow delete: if isOwner(existing().userId) || isAdmin();
    }

    // Comments
    match /comments/{commentId} {
      allow read: if true;
      allow create: if isSignedIn() && isValidId(commentId) && isValidComment(incoming()) &&
                    exists(/databases/$(database)/documents/videos/$(incoming().videoId));
      allow delete: if isOwner(existing().userId) || isAdmin();
    }

    // Follows
    match /follows/{followId} {
      allow read: if true;
      allow create: if isSignedIn() && isValidId(followId) && isValidFollow(incoming()) &&
                    exists(/databases/$(database)/documents/users/$(incoming().followingId));
      allow delete: if isOwner(existing().followerId) || isAdmin();
    }

    // Notifications
    match /notifications/{notifId} {
      allow read: if isOwner(existing().userId) || isAdmin();
      allow create: if isSignedIn(); // System/Clients create notifications
      allow update: if isOwner(existing().userId) && 
                    incoming().diff(existing()).affectedKeys().hasOnly(['read']);
      allow delete: if isOwner(existing().userId) || isAdmin();
    }

    // Wallet & Transactions
    match /boost_transactions/{txId} {
      allow read: if isOwner(existing().userId) || isAdmin();
      allow create: if isOwner(incoming().userId);
    }

    match /withdrawal_requests/{requestId} {
      allow read: if isOwner(existing().userId) || isAdmin();
      allow create: if isOwner(incoming().userId);
      allow update: if isAdmin();
    }

    match /super_chats/{chatId} {
      allow read: if isOwner(existing().senderId) || isOwner(existing().receiverId) || isAdmin();
      allow create: if isOwner(incoming().senderId);
    }
  }
}
